import { Pal, Theme } from "theme.slint";
import { T } from "i18n.slint";
import { S } from "state.slint";
import { Icon, Panel, Btn, Field, Select, Check, Slide, ProgressBar, VScroll, FieldLabel, CardHead, Chip } from "widgets.slint";

// Grupo "etiqueta + control".
component FG inherits VerticalLayout {
    in property <string> label;
    min-width: 0px;
    spacing: Theme.gap-sm;
    FieldLabel { text: root.label; }
    @children
}

// Valor del slider (chip) junto a la etiqueta.
component CqRow inherits HorizontalLayout {
    in property <int> value;
    FieldLabel { text: T.field-cq; horizontal-stretch: 1; }
    Rectangle {
        min-width: 34px;
        height: 22px;
        border-radius: Pal.brutal ? 2px : 11px;
        border-width: 1px;
        border-color: Pal.line.with-alpha(Pal.a-border);
        background: Pal.input.with-alpha(Pal.a-soft);
        Text { text: root.value; color: Pal.text; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// ======================================================================
//  Descargador
// ======================================================================
export component DownloadView inherits VerticalLayout {
    spacing: Theme.gap;

    property <bool> is-video: S.mode-idx == 0;
    property <bool> is-direct: S.direct-idx == 1;

    // ---- 1. Busqueda  |  Presets (lado a lado, como Salida | Codificacion)
    HorizontalLayout {
        spacing: Theme.gap;
        Panel {
            horizontal-stretch: 1;
            // Mismo minimo y preferido en todas las mitades: asi el reparto lo
            // decide solo el stretch y las columnas quedan alineadas entre filas.
            min-width: 0px;
            preferred-width: 0px;
            VerticalLayout {
                padding: Theme.card-pad;
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                spacing: Theme.gap-sm;
                alignment: start;
                CardHead { step: "1"; icon: "search"; title: T.cat-search; tint: Pal.c-search; }
                FieldLabel { text: T.field-url; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    url-field := Field {
                        horizontal-stretch: 1;
                        placeholder: "https://www.youtube.com/watch?v=...";
                        text <=> S.url;
                        edited(t) => { S.url-edited(t); }
                        accepted(t) => { S.fetch-formats(); }
                        changed has-focus => { S.url-has-focus = self.has-focus; }
                    }
                    Btn { icon-only: true; icon: "x"; kind: "normal"; clicked => { S.clear-url(); } }
                    Btn {
                        kind: "primary";
                        icon: S.fetching ? "spinner" : "search";
                        icon-spin: S.fetching;
                        text: S.fetching ? T.btn-fetch + "..." : T.btn-fetch;
                        enabled: !S.fetching && S.st == 1;
                        clicked => { S.fetch-formats(); }
                    }
                }
                // Solo reserva la linea cuando hay un titulo; en vacio la
                // tarjeta de busqueda queda mas compacta.
                if S.title-line != "": Text {
                    text: S.title-line;
                    color: Pal.muted;
                    font-size: 12px;
                    min-height: 19px;
                    overflow: elide;
                }
            }
        }
        Panel {
            horizontal-stretch: 1;
            // Mismo minimo y preferido en todas las mitades: asi el reparto lo
            // decide solo el stretch y las columnas quedan alineadas entre filas.
            min-width: 0px;
            preferred-width: 0px;
            VerticalLayout {
                padding: Theme.card-pad;
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                spacing: Theme.gap-sm;
                alignment: start;
                CardHead { icon: "layers"; title: T.cat-presets; tint: Pal.c-layers; }
                FieldLabel { text: T.preset-label; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Select {
                        select-id: 1;
                        horizontal-stretch: 1;
                        options: S.preset-opts;
                        current <=> S.preset-idx;
                    }
                    Btn { kind: "normal"; text: T.preset-apply; clicked => { S.apply-preset(); } }
                    Btn { kind: "normal"; icon: "check"; text: T.preset-save; clicked => { S.save-preset(); } }
                    Btn { kind: "normal"; text: T.preset-del; clicked => { S.delete-preset(); } }
                }
            }
        }
    }

    // ---- Vista previa
    if S.has-preview: Panel {
        VerticalLayout {
            padding: Theme.card-pad;
            padding-left: Theme.card-pad-x;
            padding-right: Theme.card-pad-x;
            CardHead { step: "2"; icon: "preview"; title: T.cat-preview; tint: Pal.c-preview; }
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: Theme.preview-thumb-w;
                    height: Theme.preview-thumb-h;
                    border-radius: Pal.radius-sm;
                    border-width: 1px;
                    border-color: Pal.line.with-alpha(Pal.a-border);
                    background: Pal.input;
                    clip: true;
                    if S.pv-has-thumb: Image {
                        source: S.pv-thumb;
                        image-fit: cover;
                        width: parent.width;
                        height: parent.height;
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text { text: S.pv-title; color: Pal.text; font-size: Theme.font-preview-title; font-weight: 700; wrap: word-wrap; overflow: elide; max-height: 40px; }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for c in S.pv-chips: Chip { text: c; }
                    }
                    // Una sola linea con elipsis: las descripciones largas no
                    // dejan un corte duro y la tarjeta sigue compacta.
                    Rectangle {
                        height: Theme.preview-desc-h;
                        clip: true;
                        Text {
                            text: S.pv-desc;
                            color: Pal.muted;
                            font-size: 12px;
                            width: parent.width;
                            height: parent.height;
                            wrap: no-wrap;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ---- 2. Salida  |  3. Codificacion
    HorizontalLayout {
        spacing: Theme.gap;
        Panel {
            horizontal-stretch: 1;
            // Mismo minimo y preferido en todas las mitades: asi el reparto lo
            // decide solo el stretch y las columnas quedan alineadas entre filas.
            min-width: 0px;
            preferred-width: 0px;
            VerticalLayout {
                padding: Theme.card-pad;
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                spacing: Theme.gap;
                alignment: start;
                CardHead { step: S.has-preview ? "3" : "2"; icon: "layers"; title: T.cat-output; tint: Pal.c-layers; }
                // Dos columnas para que Output & format no alargue la vista:
                // los cuatro selects caben en dos filas y el modo de
                // procesado ocupa el ancho completo.
                HorizontalLayout {
                    spacing: Theme.gap;
                    FG {
                        horizontal-stretch: 1;
                        label: T.field-mode;
                        Select {
                            select-id: 2;
                            options: [T.mode-video, T.mode-audio];
                            current <=> S.mode-idx;
                            selected(i) => { S.mode-changed(); }
                        }
                    }
                    FG {
                        horizontal-stretch: 1;
                        label: T.field-quality;
                        Select {
                            select-id: 3;
                            best: 1;
                            options: [T.q-manual, "4K · 2160p", "1440p", "1080p", "720p", "480p", T.q-h264];
                            current <=> S.quality-idx;
                            selected(i) => { S.quality-changed(); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    FG {
                        horizontal-stretch: 1;
                        label: T.field-vidfmt;
                        Select {
                            select-id: 4;
                            // Solo marcar la mejor opcion cuando ya hay formatos.
                            best: S.has-preview ? S.video-best : -1;
                            enabled: root.is-video;
                            options: S.video-opts;
                            current <=> S.video-idx;
                        }
                    }
                    FG {
                        horizontal-stretch: 1;
                        label: T.field-audfmt;
                        Select { select-id: 5; best: S.has-preview ? S.audio-best : -1; options: S.audio-opts; current <=> S.audio-idx; }
                    }
                }
                FG {
                    label: T.field-encmode;
                    Select {
                        select-id: 6;
                        options: [T.enc-reenc, T.enc-direct];
                        current <=> S.direct-idx;
                        selected(i) => { S.mode-changed(); }
                    }
                }
            }
        }
        Panel {
            horizontal-stretch: 1;
            // Mismo minimo y preferido en todas las mitades: asi el reparto lo
            // decide solo el stretch y las columnas quedan alineadas entre filas.
            min-width: 0px;
            preferred-width: 0px;
            VerticalLayout {
                padding: Theme.card-pad;
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                spacing: Theme.gap;
                alignment: start;
                CardHead { step: S.has-preview ? "4" : "3"; icon: "sliders"; title: T.cat-codec; tint: Pal.c-sliders; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    FG {
                        horizontal-stretch: 1;
                        label: T.field-hw;
                        Select {
                            select-id: 7;
                            enabled: root.is-video && !root.is-direct;
                            options: [T.hw-nvidia, T.hw-amd, T.hw-intel, T.hw-cpu];
                            current <=> S.hw-idx;
                        }
                    }
                    FG {
                        horizontal-stretch: 1;
                        label: T.field-vcodec;
                        Select {
                            select-id: 8;
                            enabled: root.is-video && !root.is-direct;
                            options: [T.codec-h264, T.codec-hevc, T.codec-av1, T.codec-vp9];
                            current <=> S.codec-idx;
                        }
                    }
                }
                FG {
                    label: T.field-acodec;
                    Select {
                        select-id: 9;
                        enabled: !root.is-video && !root.is-direct;
                        options: ["MP3", "AAC", "Opus", T.acodec-ogg, T.acodec-flac, T.acodec-wav];
                        current <=> S.acodec-idx;
                    }
                }
                VerticalLayout {
                    spacing: Theme.gap-sm;
                    CqRow { value: S.cq; }
                    Slide {
                        enabled: root.is-video && !root.is-direct;
                        value <=> S.cq;
                    }
                    HorizontalLayout {
                        Text { text: T.cq-best; color: Pal.muted; font-size: 11px; horizontal-stretch: 1; }
                        Text { text: T.cq-lite; color: Pal.muted; font-size: 11px; horizontal-alignment: right; }
                    }
                }
            }
        }
    }

    // ---- Opciones avanzadas (todo el ancho, plegable). Abiertas usan dos
    // filas cortas: los cuatro campos juntos y debajo las casillas.
    Panel {
        VerticalLayout {
            padding: Theme.card-pad;
            padding-left: Theme.card-pad-x;
            padding-right: Theme.card-pad-x;
            spacing: Theme.gap-sm;
            // CardHead normal (misma forma que las demas cabeceras); el
            // TouchArea de abajo la hace plegable.
            adv-head := CardHead {
                padding-bottom: S.adv-open ? 8px : 0px;
                icon: "sliders";
                title: T.cat-advanced;
                tint: Pal.c-sliders;
                Text { text: T.adv-hint; color: Pal.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Icon { name: "chevron-down"; size: 15px; tint: Pal.muted; }
            }
            if S.adv-open: VerticalLayout {
                spacing: Theme.gap-lg;
                HorizontalLayout {
                    spacing: Theme.gap-lg;
                    FG { label: T.adv-trim-start; horizontal-stretch: 1; Field { placeholder: "0:00"; text <=> S.trim-start; } }
                    FG { label: T.adv-trim-end; horizontal-stretch: 1; Field { placeholder: "—"; text <=> S.trim-end; } }
                    FG {
                        label: T.adv-bitrate;
                        horizontal-stretch: 1;
                        Select {
                            select-id: 10;
                            best: 1;
                            options: [T.adv-bitrate-default, "320 kbps", "256 kbps", "192 kbps", "128 kbps", "96 kbps"];
                            current <=> S.abitrate-idx;
                        }
                    }
                    FG {
                        label: T.adv-cookies;
                        horizontal-stretch: 1;
                        Select {
                            select-id: 11;
                            options: [T.adv-cookies-none, "Chrome", "Edge", "Firefox", "Brave", "Opera", "Vivaldi"];
                            current <=> S.cookies-idx;
                            selected(i) => { S.test-cookies(); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    Check { text: T.adv-subs; checked <=> S.subs; }
                    Check { text: T.adv-subs-embed; checked <=> S.subs-embed; }
                    Check { text: T.adv-norm; checked <=> S.audio-norm; }
                }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    Check { text: T.adv-embed-thumb; checked <=> S.embed-thumb; }
                    Check { text: T.adv-embed-meta; checked <=> S.embed-meta; }
                }
            }
        }
        TouchArea {
            y: 0px;
            height: Theme.card-pad + adv-head.height;
            mouse-cursor: pointer;
            clicked => { S.adv-open = !S.adv-open; }
        }
    }

    // ---- Destino  |  Descargar (lado a lado)
    HorizontalLayout {
        spacing: Theme.gap;
        Panel {
            horizontal-stretch: 1;
            // Mismo minimo y preferido que las demas mitades: columnas alineadas.
            min-width: 0px;
            preferred-width: 0px;
            VerticalLayout {
                padding: Theme.card-pad;
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                spacing: Theme.gap-sm;
                CardHead { step: S.has-preview ? "5" : "4"; icon: "folder"; title: T.cat-dest; tint: Pal.c-folder; }
                FieldLabel { text: T.field-folder; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Field {
                        horizontal-stretch: 1;
                        placeholder: "...";
                        text <=> S.out-dir;
                        edited(t) => { S.out-dir-edited(); }
                    }
                    Btn { kind: "secondary"; icon: "folder"; text: T.btn-choose; clicked => { S.choose-folder(0); } }
                }
                Text { text: S.space-hint; color: S.space-low ? Pal.warning : Pal.muted; font-size: 12px; min-height: 16px; }
            }
        }
        Panel {
            horizontal-stretch: 1;
            // Mismo minimo y preferido que las demas mitades: columnas alineadas.
            min-width: 0px;
            preferred-width: 0px;
            VerticalLayout {
                padding: Theme.card-pad;
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                spacing: Theme.gap;
                alignment: center;
                Btn {
                    height: 40px;
                    kind: "success";
                    icon: S.busy ? "spinner" : "play";
                    icon-spin: S.busy;
                    text: root.is-direct ? T.btn-download-direct : T.btn-download-reenc;
                    enabled: S.st == 1 && !S.busy;
                    clicked => { S.start-download(); }
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Btn { horizontal-stretch: 1; kind: "secondary"; icon: "layers"; text: T.btn-enqueue; enabled: S.st == 1; clicked => { S.enqueue(); } }
                    Btn { horizontal-stretch: 1; kind: "secondary"; icon: "list-plus"; text: T.btn-batch; enabled: S.st == 1; clicked => { S.batch-import(); } }
                    if S.is-playlist: Btn { horizontal-stretch: 1; kind: "secondary"; icon: "download"; text: T.btn-playlist; enabled: S.st == 1; clicked => { S.enqueue-playlist(); } }
                }
            }
        }
    }
}

// ======================================================================
//  Archivos locales
// ======================================================================
export component LocalView inherits VerticalLayout {
    spacing: Theme.gap;
    property <bool> is-video: S.local-mode-idx == 0;
    property <bool> is-audio: S.local-mode-idx == 1;
    property <bool> is-gif: S.local-mode-idx == 2;

    // ---- 1. Archivo y opciones  |  2. Codificacion (lado a lado)
    HorizontalLayout {
        spacing: Theme.gap;
        Panel {
            horizontal-stretch: 1;
            // Mismo minimo y preferido en todas las mitades: asi el reparto lo
            // decide solo el stretch y las columnas quedan alineadas entre filas.
            min-width: 0px;
            preferred-width: 0px;
            VerticalLayout {
                padding: Theme.card-pad;
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                spacing: Theme.gap-sm;
                alignment: start;
                CardHead { step: "1"; icon: "file-video"; title: T.set-local; tint: Pal.c-file; }
                FieldLabel { text: T.set-local-hint; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Field {
                        horizontal-stretch: 1;
                        read-only: true;
                        placeholder: "...";
                        text <=> S.local-file;
                        border-color: S.local-dragging ? Pal.accent : Pal.line.with-alpha(Pal.a-border);
                    }
                    Btn { kind: "secondary"; icon: "folder"; text: T.set-browse; clicked => { S.pick-local(); } }
                }
                Text { text: T.set-drop-hint; color: Pal.muted; font-size: 11.5px; }
                VerticalLayout {
                    spacing: Theme.gap-lg;
                    padding-top: 8px;
                    HorizontalLayout {
                        spacing: Theme.gap-lg;
                        FG {
                            label: T.set-local-type;
                            horizontal-stretch: 1;
                            Select {
                                select-id: 12;
                                options: [T.mode-video, T.mode-audio, T.mode-gif];
                                current <=> S.local-mode-idx;
                            }
                        }
                        FG {
                            label: T.field-acodec;
                            horizontal-stretch: 1;
                            Select {
                                select-id: 13;
                                enabled: root.is-audio;
                                options: ["MP3", "AAC", "Opus", T.acodec-ogg, T.acodec-flac, T.acodec-wav];
                                current <=> S.local-acodec-idx;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-lg;
                        FG { label: T.adv-trim-start; horizontal-stretch: 1; Field { placeholder: "0:00"; text <=> S.local-trim-start; } }
                        FG { label: T.adv-trim-end; horizontal-stretch: 1; Field { placeholder: "—"; text <=> S.local-trim-end; } }
                    }
                    if root.is-gif: HorizontalLayout {
                        spacing: Theme.gap-lg;
                        FG { label: T.gif-fps; horizontal-stretch: 1; Field { text <=> S.local-gif-fps; input-type: InputType.number; } }
                        FG { label: T.gif-width; horizontal-stretch: 1; Field { text <=> S.local-gif-width; input-type: InputType.number; } }
                    }
                    Check { text: T.adv-norm; enabled: root.is-audio; checked <=> S.local-audio-norm; }
                }
            }
        }
        Panel {
            horizontal-stretch: 1;
            // Mismo minimo y preferido en todas las mitades: asi el reparto lo
            // decide solo el stretch y las columnas quedan alineadas entre filas.
            min-width: 0px;
            preferred-width: 0px;
            VerticalLayout {
                padding: Theme.card-pad;
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                spacing: Theme.gap;
                alignment: start;
                CardHead { step: "2"; icon: "sliders"; title: T.cat-codec; tint: Pal.c-sliders; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    FG {
                        horizontal-stretch: 1;
                        label: T.field-hw;
                        Select { select-id: 14; enabled: root.is-video; options: [T.hw-nvidia, T.hw-amd, T.hw-intel, T.hw-cpu]; current <=> S.local-hw-idx; }
                    }
                    FG {
                        horizontal-stretch: 1;
                        label: T.field-vcodec;
                        Select { select-id: 15; enabled: root.is-video; options: ["H.264", "HEVC / H.265", "AV1", "VP9"]; current <=> S.local-codec-idx; }
                    }
                }
                VerticalLayout {
                    spacing: Theme.gap-sm;
                    CqRow { value: S.local-cq; }
                    Slide { enabled: root.is-video; value <=> S.local-cq; }
                }
            }
        }
    }

    // ---- Destino  |  Reencodear (lado a lado)
    HorizontalLayout {
        spacing: Theme.gap;
        Panel {
            horizontal-stretch: 1;
            // Mismo minimo y preferido que las demas mitades: columnas alineadas.
            min-width: 0px;
            preferred-width: 0px;
            VerticalLayout {
                padding: Theme.card-pad;
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                spacing: Theme.gap-sm;
                CardHead { step: "3"; icon: "folder"; title: T.cat-dest; tint: Pal.c-folder; }
                FieldLabel { text: T.field-folder; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Field { horizontal-stretch: 1; placeholder: "..."; text <=> S.local-out-dir; }
                    Btn { kind: "secondary"; icon: "folder"; text: T.btn-choose; clicked => { S.choose-folder(1); } }
                }
            }
        }
        Panel {
            horizontal-stretch: 1;
            // Mismo minimo y preferido que las demas mitades: columnas alineadas.
            min-width: 0px;
            preferred-width: 0px;
            VerticalLayout {
                padding: Theme.card-pad;
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                alignment: center;
                Btn {
                    height: 40px;
                    kind: "success";
                    icon: S.busy ? "spinner" : "play";
                    icon-spin: S.busy;
                    text: root.is-audio ? T.set-local-to-audio : root.is-gif ? T.set-local-to-gif : T.set-local-go;
                    enabled: !S.busy;
                    clicked => { S.reencode-local(); }
                }
            }
        }
    }
}

// ======================================================================
//  Cola
// ======================================================================
export component QueueView inherits VerticalLayout {
    Panel {
        VerticalLayout {
            padding: Theme.card-pad;
            padding-left: Theme.card-pad-x;
            padding-right: Theme.card-pad-x;
            spacing: 8px;
            CardHead {
                icon: "layers";
                title: T.cat-queue;
                tint: Pal.c-layers;
                Rectangle { horizontal-stretch: 1; }
                Btn { small: true; text: T.queue-clear; clicked => { S.queue-clear(); } }
            }
            if S.queue.length == 0: Text {
                text: T.queue-empty;
                color: Pal.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            for q in S.queue: Rectangle {
                height: 38px;
                border-radius: Pal.radius-sm;
                border-width: Pal.brutal ? 2px : 1px;
                border-color: q.status == 1 ? Pal.accent : Pal.line.with-alpha(Pal.a-border);
                background: Pal.input.with-alpha(Pal.a-soft);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: Theme.gap-lg;
                    Rectangle {
                        width: 96px;
                        // Igual que Chip: recuadro redondeado. Un radio enorme
                        // (999px) no se recorta a la mitad del alto y sale un ovalo.
                        border-radius: Pal.brutal ? 2px : 6px;
                        background: q.status == 2 ? Pal.success : q.status == 3 ? Pal.danger : q.status == 1 ? Pal.accent : Pal.panel-strong;
                        Text {
                            text: q.status == 0 ? T.q-pending : q.status == 1 ? T.q-running : q.status == 2 ? T.q-done : T.q-failed;
                            color: q.status == 0 ? Pal.muted : Pal.on-accent;
                            font-size: 11.5px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: q.title; color: Pal.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        if q.status == 2 && q.output != "": Btn { small: true; icon-only: true; icon: "folder"; clicked => { S.queue-open(q.id); } }
                        if q.status != 1: Btn { small: true; icon-only: true; icon: "x"; clicked => { S.queue-remove(q.id); } }
                    }
                }
            }
        }
    }
}

// ======================================================================
//  Actividad (progreso + consola)
// ======================================================================
export component ActivityCard inherits Panel {
    // Version flotante (Descargador / Archivos locales): opaca y con boton
    // para cerrarla. En la pestana Cola va integrada como siempre.
    in property <bool> floating: false;
    alpha: root.floating ? Pal.a-solid : Pal.a-panel;
    // Color del estado del trabajo actual.
    property <color> st-color: S.current-state == 2 ? Pal.success : S.current-state == 3 ? Pal.danger : Pal.accent;
    VerticalLayout {
        padding: Theme.card-pad;
        padding-left: Theme.card-pad-x;
        padding-right: Theme.card-pad-x;
        spacing: 8px;
        CardHead {
            icon: "play";
            title: T.cat-activity;
            tint: Pal.c-terminal;
            Rectangle { horizontal-stretch: 1; }
            Btn {
                small: true;
                icon: "terminal";
                text: T.act-details;
                clicked => { S.modal = 5; }
            }
            if S.can-open-folder: Btn { small: true; icon: "folder"; text: T.btn-open-folder; clicked => { S.open-last-folder(); } }
            Btn { small: true; icon: "hard-drive"; text: T.btn-history; clicked => { S.modal = 4; S.history-opened(); } }
            // Solo se puede cerrar cuando no hay nada en marcha: asi Cancelar
            // siempre queda a la vista mientras trabaja.
            if root.floating && S.current-state != 1: Btn { small: true; icon-only: true; icon: "x"; clicked => { S.act-visible = false; } }
        }
        // ---- trabajo actual
        Rectangle {
            height: 52px;
            border-radius: Pal.radius-sm;
            border-width: Pal.border-w;
            border-color: Pal.line.with-alpha(Pal.a-border);
            background: Pal.input.with-alpha(Pal.a-soft);
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 12px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: Pal.brutal ? 2px : 16px;
                        background: root.st-color.with-alpha(0.18);
                        Icon {
                            x: (parent.width - 16px) / 2;
                            y: (parent.height - 16px) / 2;
                            width: 16px;
                            height: 16px;
                            size: 16px;
                            name: S.current-state == 1 ? "spinner" : S.current-state == 2 ? "check" : S.current-state == 3 ? "error" : "download";
                            spin: S.current-state == 1;
                            tint: root.st-color;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: S.current-title != "" ? S.current-title : T.act-idle;
                        color: Pal.text;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: S.current-state == 0 ? T.act-idle-hint : S.progress-label;
                        color: Pal.muted;
                        font-size: 12px;
                        // Con elide Slint descarta la linea si el alto asignado queda una fraccion
                        // por debajo del alto de linea (pasaba con Poppins Medium a 12 px): un
                        // minimo algo mayor que la linea evita que el texto desaparezca.
                        min-height: 19px;
                        overflow: elide;
                    }
                }
                if S.current-state != 0: Text {
                    text: Math.round(S.progress * 100) + "%";
                    color: root.st-color;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                // Cancelar junto a lo que cancela (antes estaba en la barra de
                // acciones, casi siempre deshabilitado).
                if S.busy: VerticalLayout {
                    alignment: center;
                    Btn { small: true; kind: "danger"; icon: "stop"; text: T.btn-cancel; clicked => { S.cancel(); } }
                }
            }
        }
        ProgressBar { value: S.progress; }
        // ---- ultimos eventos (solo los que hay: sin hueco vacio). El
        // registro tecnico completo se abre en un modal con "Detalles".
        if S.events.length > 0: VerticalLayout {
            spacing: 2px;
            for l in S.events: HorizontalLayout {
                spacing: 8px;
                padding-top: l.level == 5 ? 4px : 1px;
                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    Icon {
                        size: 14px;
                        name: l.level == 2 ? "check" : l.level == 3 ? "warning" : l.level == 5 ? "play" : "info";
                        tint: l.level == 2 ? Pal.success : l.level == 3 ? Pal.danger : l.level == 5 ? Pal.accent : Pal.muted;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: l.text;
                    wrap: word-wrap;
                    font-size: 12.5px;
                    font-weight: l.level == 5 ? 700 : 500;
                    color: l.level == 3 ? Pal.danger : l.level == 5 ? Pal.text : Pal.text.with-alpha(0.85);
                }
            }
        }
    }
}
