// Paleta global. Rust la rellena al cambiar de tema (ver src/themes.rs).
// Los valores por defecto son Catppuccin Mocha.
export global Pal {
    in-out property <color> bg: #181825;
    in-out property <color> bg-accent: #1e1e2e;
    in-out property <color> surface: #11111b;
    in-out property <color> panel: #1e1e2e;
    in-out property <color> panel-strong: #313244;
    in-out property <color> input: #11111b;
    in-out property <color> line: #313244;
    in-out property <color> line-strong: #45475a;
    in-out property <color> text: #cdd6f4;
    in-out property <color> muted: #a6adc8;
    in-out property <color> accent: #cba6f7;
    in-out property <color> accent2: #89b4fa;
    in-out property <color> success: #a6e3a1;
    in-out property <color> danger: #f38ba8;
    in-out property <color> warning: #f9e2af;
    in-out property <color> on-accent: #11111b;

    in-out property <color> log-bg: #0f1020;
    in-out property <color> log-text: #cdd6f4;
    in-out property <color> log-border: #45475a;
    in-out property <color> log-cmd: #89dceb;
    in-out property <color> log-info: #a6adc8;
    in-out property <color> log-ok: #a6e3a1;
    in-out property <color> log-err: #f38ba8;

    // Colores por seccion (en Catppuccin cada icono tiene el suyo).
    in-out property <color> c-search: #74c7ec;
    in-out property <color> c-preview: #f5c2e7;
    in-out property <color> c-layers: #89b4fa;
    in-out property <color> c-sliders: #fab387;
    in-out property <color> c-folder: #f9e2af;
    in-out property <color> c-file: #94e2d5;
    in-out property <color> c-terminal: #a6e3a1;

    in-out property <length> radius: 16px;
    in-out property <length> radius-sm: 10px;
    in-out property <length> border-w: 1px;

    // "Cristal": transparencias de paneles, piezas pequenas, cabeceras y modales.
    in-out property <float> a-panel: 0.62;
    in-out property <float> a-soft: 0.46;
    in-out property <float> a-strong: 0.88;
    in-out property <float> a-solid: 0.96;
    in-out property <float> a-border: 0.36;
    in-out property <color> highlight: #ffffff12;

    // Neo Brutalist: sombras duras en lugar de cristal.
    in-out property <bool> brutal: false;
    in-out property <color> hard-panel: #171717;
    in-out property <color> hard-ctrl: #171717;
}
