import "../assets/fonts/Poppins-Regular.ttf";
import "../assets/fonts/Poppins-Bold.ttf";

import { Pal, Theme } from "theme.slint";
import { T } from "i18n.slint";
import { S } from "state.slint";
import { Icon, Panel, VScroll } from "widgets.slint";
import { DownloadView, LocalView, QueueView, ActivityCard } from "views.slint";
import { AllModals } from "modals.slint";

export { S, T, Pal }
export { LogLine, QItem, HItem, DepInfo, ThemeEntry } from "state.slint";

// Boton de la barra de titulo (minimizar / maximizar / cerrar): pastilla
// redondeada que se ilumina al pasar el raton; cerrar se pone roja.
component WinButton inherits Rectangle {
    in property <string> icon;
    in property <bool> is-close: false;
    callback clicked();
    width: 38px;
    height: 26px;
    border-radius: Pal.brutal ? 2px : 7px;
    border-width: Pal.brutal && ta.has-hover ? 2px : 0px;
    border-color: Pal.line;
    background: ta.pressed ? (is-close ? #b82c40 : Pal.panel-strong.with-alpha(0.95))
        : ta.has-hover ? (is-close ? #e5484d : Pal.panel-strong.with-alpha(0.75))
        : Pal.input.with-alpha(0.35);
    animate background { duration: 120ms; }
    Icon {
        name: root.icon;
        size: 13px;
        tint: ta.has-hover && root.is-close ? #ffffff : ta.has-hover ? Pal.text : Pal.muted;
        x: (parent.width - 13px) / 2;
        y: (parent.height - 13px) / 2;
        width: 13px;
        height: 13px;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Boton plano del grupo de controles del header.
component HeaderBtn inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> icon-only: false;
    callback clicked();
    height: Theme.control-h;
    horizontal-stretch: 0;
    min-width: icon-only ? Theme.control-h : 0px;
    border-radius: Math.max(2px, Theme.radius-sm - 4px);
    background: ta.pressed ? Pal.panel-strong.with-alpha(0.95) : ta.has-hover ? Pal.panel-strong.with-alpha(0.55) : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: icon-only ? 0px : Theme.btn-pad-x;
        padding-right: icon-only ? 0px : Theme.btn-pad-x;
        spacing: 6px;
        alignment: center;
        Icon { name: root.icon; size: 15px; tint: ta.has-hover ? Pal.text : Pal.muted; }
        if !root.icon-only: Text {
            text: root.text;
            color: ta.has-hover ? Pal.text : Pal.muted;
            font-size: Theme.font-btn;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Separador vertical sutil entre grupos del header.
component HeaderSep inherits Rectangle {
    min-width: 1px;
    max-width: 1px;
    background: Pal.line.with-alpha(Pal.a-border * 0.8);
}

// Pestana del selector Descargador / Archivos locales / Cola.
component TabBtn inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active;
    in property <int> badge: 0;
    callback clicked();
    min-height: Theme.tab-h;
    border-radius: Math.max(2px, Pal.radius-sm - 2px);
    border-width: 1px;
    background: active ? Pal.accent : ta.has-hover ? Pal.panel-strong : transparent;
    border-color: active ? Pal.accent : transparent;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Icon { name: root.icon; size: 16px; tint: root.active ? Pal.on-accent : Pal.muted; }
        Text {
            text: root.text;
            color: root.active ? Pal.on-accent : ta.has-hover ? Pal.text : Pal.muted;
            font-weight: 700;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
        if root.badge > 0: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: root.active ? Pal.on-accent : Pal.accent;
            Text {
                text: root.badge;
                color: root.active ? Pal.accent : Pal.on-accent;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Pildora de estado de dependencias (plana: vive dentro del grupo del header).
component StatusPill inherits Rectangle {
    background: transparent;
    border-radius: Pal.brutal ? 2px : 999px;
    border-width: 0px;
    height: Theme.control-h;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        alignment: center;
        if S.st != 1: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: S.st == 2 ? Pal.danger : Pal.warning;
        }
        if S.st != 1: Text {
            text: S.st == 0 ? T.st-checking : T.st-missing + S.st-missing;
            color: S.st == 2 ? Pal.danger : Pal.muted;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
            max-width: 200px;
        }
        if S.st == 1: HorizontalLayout {
            spacing: 4px;
            Icon { name: "check"; size: 13px; tint: Pal.success; }
            Text { text: "yt-dlp"; color: Pal.success; font-size: 11px; font-weight: 700; vertical-alignment: center; }
        }
        if S.st == 1: HorizontalLayout {
            spacing: 4px;
            Icon { name: "check"; size: 13px; tint: Pal.success; }
            Text { text: "ffmpeg"; color: Pal.success; font-size: 11px; font-weight: 700; vertical-alignment: center; }
        }
        if S.st == 1: Rectangle { width: 1px; height: 12px; y: (parent.height - self.height) / 2; background: Pal.line.with-alpha(0.7); }
        if S.st == 1: HorizontalLayout {
            spacing: 4px;
            Icon { name: "chip"; size: 13px; tint: S.gpu == "nvidia" ? #76b900 : S.gpu == "amd" ? #ff4d4d : #4da3ff; }
            Text {
                text: S.gpu == "nvidia" ? "NVIDIA" : S.gpu == "amd" ? "AMD" : "CPU";
                color: S.gpu == "nvidia" ? #76b900 : S.gpu == "amd" ? #ff4d4d : #4da3ff;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
    }
}

export component App inherits Window {
    title: "LiquidCat";
    // Icono inicial; themes::refresh_logo lo cambia por el del tema.
    icon: @image-url("../assets/logo.png");
    no-frame: true;
    min-width: 860px;
    min-height: 560px;
    preferred-width: 1180px;
    preferred-height: 800px;
    // Ventana opaca: las esquinas las recorta Windows (DWM), asi no queda
    // ningun fondo detras de la silueta redondeada.
    background: Pal.bg;
    default-font-family: "Poppins";
    default-font-size: 14px;

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (S.dd-owner != 0) { S.dd-owner = 0; }
                else if (S.dlg != 0) { S.dialog-cancel(); } else { S.modal = 0; }
                return accept;
            }
            if (e.modifiers.control && e.text == "v" && S.modal == 0 && S.dlg == 0 && !S.url-has-focus) {
                S.paste-url();
                return accept;
            }
            return reject;
        }
    }

    // La silueta redondeada la pone Windows (DWM). El contenido va a escuadra:
    // asi no aparece ninguna franja de fondo entre el borde del sistema y el
    // nuestro, y al maximizar no quedan huecos.
    property <length> corner-radius: 0px;

    // Si cambia el modal, cualquier desplegable abierto deja de tener dueno.
    property <int> modal-idx: S.modal;
    changed modal-idx => { S.dd-owner = 0; }

    // Contenedor principal.
    Rectangle {
        border-radius: root.corner-radius;
        clip: true;
        background: Pal.bg;

    VerticalLayout {
        // ------------------------------------------------ barra de titulo
        Rectangle {
            // Barra de 38 px: nombre de la app mas visible y botones de
            // ventana en pastillas redondeadas.
            height: 38px;
            border-top-left-radius: root.corner-radius;
            border-top-right-radius: root.corner-radius;
            background: Pal.surface.with-alpha(Pal.a-strong);
            Rectangle { y: parent.height - Pal.border-w; height: Pal.border-w; background: Pal.line.with-alpha(Pal.a-border); }
            TouchArea {
                width: parent.width - 140px;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { S.win-drag(); }
                }
                double-clicked => { S.win-maximize(); }
            }
            // Nombre de la app centrado en la barra de titulo.
            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: "LiquidCat";
                color: Pal.text;
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 4px;
                alignment: end;
                Rectangle { horizontal-stretch: 1; }
                WinButton { y: (parent.height - self.height) / 2; icon: "minus"; clicked => { S.win-minimize(); } }
                WinButton { y: (parent.height - self.height) / 2; icon: S.maximized ? "restore" : "maximize"; clicked => { S.win-maximize(); } }
                WinButton { y: (parent.height - self.height) / 2; icon: "x"; is-close: true; clicked => { S.win-close(); } }
            }
        }

        // ------------------------------------------------ cuerpo
        Rectangle {
            vertical-stretch: 1;
            border-bottom-left-radius: root.corner-radius;
            border-bottom-right-radius: root.corner-radius;
            background: @linear-gradient(145deg, Pal.bg-accent 0%, Pal.bg 54%);
            clip: true;

            VerticalLayout {
                padding-left: Theme.card-pad-x;
                padding-right: Theme.card-pad-x;
                padding-top: Theme.card-pad;
                padding-bottom: Theme.card-pad;
                spacing: Theme.gap;

                // cabecera
                Panel {
                    // Neo Brutalist añade el badge "OZO MEDIA WORKSPACE" encima
                    // del titulo: necesita mas alto para no desbordar.
                    height: Pal.brutal ? Theme.header-h + 20px : Theme.header-h;
                    HorizontalLayout {
                        padding-left: Theme.card-pad-x;
                        padding-right: Theme.card-pad-x;
                        spacing: 12px;
                        // Logo de marca en la cabecera; el de la barra de
                        // titulo se quito para no duplicarlo.
                        VerticalLayout {
                            alignment: center;
                            // Icono propio de cada tema (assets/theme-icons), sin
                            // marco: llena el recuadro hasta la orilla.
                            Rectangle {
                                width: 46px;
                                height: 46px;
                                border-radius: Pal.brutal ? 2px : 12px;
                                clip: true;
                                Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: S.logo;
                                    image-fit: cover;
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            // El badge va en una fila con relleno elastico: un hijo
                            // de ancho fijo directo en el VerticalLayout le pondria
                            // a toda la columna ese ancho maximo (164px), el titulo
                            // se cortaba y el grupo de estado se estiraba.
                            if Pal.brutal: HorizontalLayout {
                                Rectangle {
                                    height: 17px;
                                    width: 164px;
                                    background: Pal.accent;
                                    border-width: 2px;
                                    border-color: Pal.line;
                                    Text { text: "OZO MEDIA WORKSPACE"; color: Pal.on-accent; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text { text: "LiquidCat"; color: Pal.text; font-size: 19px; font-weight: 700; }
                            Text { text: T.app-subtitle; color: Pal.muted; font-size: 11.5px; overflow: elide; }
                        }
                        // Un solo grupo: estado + acciones, misma altura,
                        // mismo padding y separadores sutiles. El VerticalLayout
                        // centra el grupo verticalmente dentro de la barra.
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Rectangle {
                                // El borde del grupo (3 px en Neo Brutalist) no
                                // debe quedar debajo de los botones.
                                height: Theme.control-h + 2 * Pal.border-w;
                                border-radius: Theme.radius-sm;
                                border-width: Pal.border-w;
                                border-color: Pal.line.with-alpha(Pal.a-border);
                                background: Pal.input.with-alpha(0.35);
                                clip: true;
                                HorizontalLayout {
                                    padding: Pal.border-w;
                                    spacing: 0px;
                                    StatusPill { }
                                    HeaderSep { }
                                    HeaderBtn { icon: "book"; text: T.btn-wiki; clicked => { S.modal = 3; } }
                                    HeaderBtn { icon: "info"; text: T.btn-credits; clicked => { S.modal = 2; } }
                                    HeaderSep { }
                                    HeaderBtn { icon-only: true; icon: "settings"; clicked => { S.modal = 1; S.settings-opened(); } }
                                }
                            }
                        }
                    }
                }

                // pestanas
                Panel {
                    height: Theme.tab-h + 8px;
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 5px;
                        TabBtn { horizontal-stretch: 1; icon: "download"; text: T.tab-download; active: S.tab == 0; clicked => { S.tab = 0; } }
                        TabBtn { horizontal-stretch: 1; icon: "file-video"; text: T.tab-local; active: S.tab == 1; clicked => { S.tab = 1; } }
                        TabBtn { horizontal-stretch: 1; icon: "layers"; text: T.tab-queue; active: S.tab == 2; badge: S.queue-active; clicked => { S.tab = 2; } }
                    }
                }

                // area de trabajo con scroll
                main-scroll := VScroll {
                    vertical-stretch: 1;
                    // Deja la barra en el margen, fuera de las tarjetas.
                    rail: Theme.scroll-rail;
                    // Al cambiar de pestana se empieza desde arriba.
                    property <int> tab: S.tab;
                    changed tab => { self.reset(); S.dd-owner = 0; }
                    VerticalLayout {
                        spacing: Theme.gap;
                        padding-right: Pal.brutal ? 8px : 0px;
                        padding-bottom: Pal.brutal ? 8px : 0px;
                        if S.tab == 0: DownloadView { }
                        if S.tab == 1: LocalView { }
                        if S.tab == 2: QueueView { }
                        ActivityCard { }
                    }
                }
            }

            // modales y dialogos
            AllModals { }

            // aviso flotante
            if S.toast-on: Rectangle {
                x: parent.width - self.width - 20px;
                y: parent.height - self.height - 20px;
                width: Math.min(480px, Math.max(260px, S.toast-text.character-count * 7.5px + 70px));
                height: 46px;
                border-radius: Pal.radius-sm;
                border-width: Pal.border-w;
                border-color: Pal.line-strong.with-alpha(0.5);
                background: Pal.panel-strong.with-alpha(Pal.a-strong);
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    Icon {
                        name: S.toast-kind == 1 ? "check" : S.toast-kind == 2 ? "warning" : S.toast-kind == 3 ? "error" : "message";
                        tint: S.toast-kind == 1 ? Pal.success : S.toast-kind == 2 ? Pal.warning : S.toast-kind == 3 ? Pal.danger : Pal.accent;
                    }
                    Text { text: S.toast-text; color: Pal.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }
    }

    // ---- desplegable compartido: se pinta dentro de la ventana (sin
    // PopupWindow) para que abrir/cerrar no deje zonas sin repintar.
    if S.dd-owner != 0: ddl := Rectangle {
        property <length> ph: Math.min(S.dd-options.length * Theme.control-h-sm + 12px, 280px);
        // La lista puede ser mas ancha que su selector: en media columna las
        // opciones largas (formatos) se cortaban.
        property <length> pw: Math.min(Math.max(S.dd-w, 340px), ddl.width - 12px);
        property <length> top: S.dd-y + S.dd-h + 5px;

        // Clic fuera del panel: cierra. La rueda no mueve la pagina de fondo.
        TouchArea {
            clicked => { S.dd-owner = 0; }
            scroll-event(e) => { return EventResult.accept; }
        }

        Rectangle {
            // Alinear a pixeles FISICOS (phx), no logicos: con escala 125 %/150 %
            // un px logico entero cae en medio de un pixel fisico y el texto
            // se ve borroso (a 100 % ambos coinciden, por eso solo fallaba
            // en la pantalla del laptop).
            x: Math.round(Math.max(6px, Math.min(S.dd-x, ddl.width - ddl.pw - 6px)) / 1phx) * 1phx;
            y: Math.round(Math.max(6px, ddl.top + ddl.ph <= ddl.height - 6px ? ddl.top : S.dd-y - 5px - ddl.ph) / 1phx) * 1phx;
            width: Math.round(ddl.pw / 1phx) * 1phx;
            height: Math.round(ddl.ph / 1phx) * 1phx;
            // Opaco: el fondo semitransparente dejaba ver el texto de debajo y
            // las opciones parecian desenfocadas.
            background: Pal.panel;
            border-radius: Pal.radius-sm;
            border-width: Pal.border-w;
            border-color: Pal.line-strong.with-alpha(Math.min(1.0, Pal.a-border + 0.1));
            clip: true;

            // Evita que un clic en el borde del panel cierre la lista.
            TouchArea { }

            Flickable {
                // Un Flickable no toma el tamano del padre por si solo: sin
                // width/height explicitos su contenido (las opciones) queda
                // recortado y la lista se ve vacia.
                width: parent.width;
                height: parent.height;
                viewport-height: S.dd-options.length * Theme.control-h-sm + 12px;
                for opt[i] in S.dd-options: Rectangle {
                    x: Math.round(6px / 1phx) * 1phx;
                    y: Math.round((6px + i * Theme.control-h-sm) / 1phx) * 1phx;
                    width: Math.round((parent.width - 12px) / 1phx) * 1phx;
                    height: Math.round(Theme.control-h-sm / 1phx) * 1phx;
                    border-radius: Math.max(2px, Pal.radius-sm - 3px);
                    background: it.has-hover ? Pal.accent.with-alpha(0.22) : i == S.dd-current ? Pal.accent.with-alpha(0.12) : transparent;
                    Text {
                        x: 11px;
                        y: 0px;
                        // Reserva espacio para la estrella de "mejor opcion".
                        width: parent.width - (i == S.dd-best ? 40px : 22px);
                        height: parent.height;
                        text: opt;
                        color: i == S.dd-current ? Pal.accent : Pal.text;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if i == S.dd-best: Icon {
                        x: parent.width - 22px;
                        y: (parent.height - 13px) / 2;
                        width: 13px;
                        height: 13px;
                        name: "star";
                        size: 13px;
                        tint: Pal.warning;
                    }
                    it := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            S.dd-picked = i;
                            S.dd-pick-rev += 1;
                        }
                    }
                }
            }
        }
    }

    // ---- bordes para redimensionar (ventana sin marco)
    if !S.maximized: Rectangle {
        TouchArea { x: 0px; y: 8px; width: 5px; height: parent.height - 16px; mouse-cursor: ew-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.win-resize(0); } } }
        TouchArea { x: parent.width - 5px; y: 8px; width: 5px; height: parent.height - 16px; mouse-cursor: ew-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.win-resize(1); } } }
        TouchArea { x: 8px; y: parent.height - 5px; width: parent.width - 16px; height: 5px; mouse-cursor: ns-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.win-resize(2); } } }
        TouchArea { x: 8px; y: 0px; width: parent.width - 16px; height: 3px; mouse-cursor: ns-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.win-resize(3); } } }
        TouchArea { x: parent.width - 12px; y: parent.height - 12px; width: 12px; height: 12px; mouse-cursor: nwse-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.win-resize(4); } } }
        TouchArea { x: 0px; y: parent.height - 12px; width: 12px; height: 12px; mouse-cursor: nesw-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.win-resize(5); } } }
    }
}
